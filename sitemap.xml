# SITEMAP.XML SABLON – XML Webhelytérkép keresőmotorok számára
<!-- ======================================================================= -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
    
    <!-- Főoldal -->
    <url>
        <loc>https://seo-template.example.com/</loc>
        <lastmod>2026-06-08T21:45:00+02:00</lastmod>
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
    </url>
    
    <!-- Példa egy aloldalra (pl. szolgáltatások) -->
    <url>
        <loc>https://seo-template.example.com/szolgaltatasok</loc>
        <lastmod>2026-06-08T18:30:00+02:00</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    
    <!-- Példa egy blog cikkre -->
    <url>
        <loc>https://seo-template.example.com/blog/hogyan-mukodik-a-seo</loc>
        <lastmod>2026-06-08T20:15:00+02:00</lastmod>
        <changefreq>never</changefreq>
        <priority>0.6</priority>
    </url>

</urlset>
